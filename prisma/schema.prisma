generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// جنسُ صاحب الحساب — يختاره بنفسه، ولا يُخمَّن من اسمه.
///
/// لأجل المخاطبة وحدها: «قائدة قسم» لا «قائد قسم»، و«أهلاً بكِ» لا «بك».
/// ويبقى فارغاً لمن لم يختر، فيُخاطَب بصيغةٍ محايدة لا بالمذكّر افتراضاً.
enum Gender {
  male
  female
}

enum UserRole {
  super_admin
  executive
  operations_officer
  department_admin
}

enum InviteTargetRole {
  member
  department_admin
  operations_officer
  executive
}

enum InviteStatus {
  open
  used
  expired
}

enum TestStatus {
  not_started
  passed
  failed
}

enum ApprovalStatus {
  pending_review
  approved
  rejected
}

enum RequestType {
  welcome_banner
  custom_design
  dept_contact
  meeting
  content_writing
  design_work
  publishing
  tech_support
  hr_support
  equipment
  budget_approval
  escalate_to_executive
  escalate_to_founder
  other
}

enum RequestStatus {
  new
  in_progress
  done
  overdue
}

enum TestTrackScope {
  department_member
  department_admin
  operations_officer
  executive
}

/// حالة طلب الاعتماد الإداري على تذكرة.
///
/// وهي مستقلّة عن `TicketStatus`: التذكرة قد تكون مفتوحة وطلبُها معتمداً،
/// أو مفتوحة وطلبُها مردوداً للتعديل. فخلطُهما في عمودٍ واحد يُفقِد
/// أحدهما — وقد كان ذلك أول ما فكّرت فيه.
///
/// والحالة تعكس **آخر إجراءٍ فعلي**: فتحُ الطلب واستعراضُه لا يُغيّرها.
enum ApprovalState {
  /// مسودة: صاحبها يُعدّها ولم تُرسَل بعد
  draft
  /// بانتظار الاعتماد: وصلت المعتمِد ولم يقرأها بعد
  awaiting
  /// قيد المراجعة: المعتمِد أعلن أنه يدرسها — إجراءٌ صريح لا أثرُ فتح
  reviewing
  /// مردودة للتعديل: بملاحظاتٍ مكتوبة، وصاحبها يُعدّل ويُعيد
  returned
  /// معتمدة — وإن كان المسار متسلسلاً فهذا اعتماد المرحلة الحالية
  approved
  /// مرفوضة بسببٍ مكتوب
  rejected
  /// قيد التنفيذ: انتقل صاحبها إلى العمل بعد الاعتماد
  executing
  /// مكتملة
  completed
}

/// نوع طلب الاعتماد — يُعرَض ويُصفّى به، ولا يُغيّر المسار بنفسه
enum ApprovalKind {
  marketing_plan
  financial_plan
  initiative
  resources
  operational
  other
}

/// قرارُ معتمِدٍ على طلب — سجلٌّ لا يُعدَّل ولا يُحذف.
///
/// القرارات تُحفظ صفّاً لكل قرار لا عموداً يُستبدَل: الطلب الذي رُدّ
/// للتعديل ثم أُعيد ثم اعتُمد له ثلاثة قرارات، ولو كُتب كلٌّ فوق سابقه
/// لم يبقَ من التاريخ إلا آخرُه. وهذا هو سجلّ التدقيق.
model ApprovalDecision {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// من قرّر — ولا يُحذف قرارُه بحذف حسابه، بل يُفَكّ ويبقى اسمُه
  deciderId  String?
  decider    User?         @relation("ApprovalDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  /// الاسم محفوظٌ نصّاً أيضاً: القرار ينسب إلى صاحبه حتى لو زال حسابه
  deciderName String
  /// الحالة التي صار إليها الطلب بهذا القرار
  decision   ApprovalState
  /// الملاحظة — إلزاميةٌ في الردّ للتعديل والرفض
  note       String?
  /// رقم المرحلة في المسار المتسلسل: ١ للمعتمِد الأول، ٢ للذي يليه
  step       Int           @default(1)
  decidedAt  DateTime      @default(now())

  @@index([ticketId, decidedAt])
}

enum TicketStatus {
  open
  in_progress
  resolved
}

/// مرحلة تصعيد التذكرة: القسم المستهدف أولاً (يومان) ← قائد قسم العضو نفسه
/// (يومان إضافيان) ← الإدارة التنفيذية (نهائي)
enum TicketStage {
  department
  lead_escalation
  ceo_escalation
  founder_escalation
}

/// حالةُ اللجنة في مسارها من الاقتراح إلى الفتح.
///
/// و`null` ليست حالةً ناقصة: هي علامةُ القسم الأصيل. الأقسام لا تُعتمَد
/// — تُنشَأ بقرار من يملك الهيكل. واللجنة وحدها تمرّ باعتماد.
enum CommitteeStatus {
  /// اقترحها قائد القسم وتنتظر قرار المدير التنفيذي
  pending_review
  /// اعتُمدت فانفتحت: لها بنك أسئلة، وتُدعى لها قيادة، وتظهر في الهيكل
  approved
  /// رُدَّت بسببٍ مكتوب — لا تُفتح ولا تظهر في الهيكل
  rejected
}

/// قسم داخلي — كل قسم له لون هوية خاص (hex) يُستخدم في تخصيص الواجهات.
///
/// **واللجنة قسمٌ له أبٌ لا جدولٌ ثانٍ.** وهذا أهمُّ قرارٍ في هذه
/// الميزة: لو كانت اللجنة جدولاً مستقلاً لاحتاجت دعواتَها وبنكَ أسئلتها
/// وتذاكرَها وتوقيعاتَها وإعلاناتَها وصفَّها في الهيكل — نسخةً ثانية من
/// سبعة مسارات، يُصلَح أحدها ويُنسى توأمُه. وبـ`parentId` وحده دارت
/// الدائرةُ كما طُلبت: قائدُ اللجنة `department_admin` قسمُه اللجنة،
/// فلوحتُه ودعواتُه واختبارُه وتذاكرُه تعمل من يومها بلا سطرٍ جديد.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  colorHex  String
  createdAt DateTime @default(now())

  /// قسم استثنائي لا يُدار كبقية الأقسام: أعضاؤه (ممثل قانوني، مستشار،
  /// جهة خارجية) يتبعون الإدارة العليا وحدها، ولا تُوجَّه إليهم تذاكر
  /// الأقسام ولا تصلهم إعلاناتها. وجوده بعلم الإدارة العليا لا بإدارتها.
  leadershipOnly Boolean @default(false)

  /// أبُ اللجنة — القسم الذي هي داخله. و`null` قسمٌ أصيل.
  ///
  /// والحذف مقيَّد (`Restrict`) عمداً: قسمٌ يحمل لجنةً لا يُحذف حتى
  /// تُفرَّغ لجنتُه — فلا تبقى لجنةٌ معلّقةٌ بأبٍ زائل.
  parentId   String?
  parent     Department?  @relation("DepartmentCommittees", fields: [parentId], references: [id], onDelete: Restrict)
  committees Department[] @relation("DepartmentCommittees")

  /// `null` للقسم الأصيل، وللجنة حالتُها في مسار الاعتماد
  committeeStatus CommitteeStatus?

  /// المسمّى الذي يحمله قائد اللجنة — «مسؤول لجنة التطوير» وما شابه.
  /// يختاره قائدُ القسم حين يقترحها، فلا يُسمّي القائدُ نفسَه بما يشاء.
  leadTitle       String?

  /// من اقترحها ومتى. والمعرّف نصٌّ بلا علاقةٍ أجنبية عن قصد: علاقةٌ
  /// لازمة إلى `User` تمنع حذف الحساب بقيدٍ غامض (P2003) — وقد وقع ذلك
  /// في هذه المنصة من قبل بـ`Invite.invitedById`. والاسم محفوظٌ نصّاً
  /// فيبقى منسوباً لصاحبه ولو زال حسابه.
  requestedById   String?
  requestedByName String?
  requestedAt     DateTime?

  /// القرار: متى، وبيد من، وبأي ملاحظة — والملاحظة إلزاميةٌ في الردّ
  decidedAt       DateTime?
  decidedByName   String?
  decisionNote    String?

  admins        User[]
  invites       Invite[]
  members       Member[]
  requests      Request[]      @relation("TargetDepartmentRequests")
  testTracks    TestTrack[]
  signatures    LeaderSignature[]
  tickets       Ticket[]       @relation("TicketTargetDepartment")
  announcements Announcement[]

  // نظامُ التنفيذ الاستراتيجي
  objectives    DepartmentObjective[]
  weekPlans     WeekPlan[]
  planTasks     PlanTask[]

  /// «لجانُ هذا القسم» سؤالٌ يُسأل في كل قراءةٍ للوحة القسم وللهيكل.
  /// (كان الفهرسُ مكتوباً في ترحيلِ اللجان وحدَه ولم يُصرَّح به هنا،
  /// فكاد فرقُ المخطّط التالي يُسقطه.)
  @@index([parentId])
}

/// حساب إداري (قائد قسم / تنفيذي / الإدارة العليا) — يُنشأ إما مباشرة (بذرة النظام)
/// أو تلقائياً عند اعتماد مرشح قيادي بعد اجتيازه اختبار المستوى المناسب
model User {
  id                 String      @id @default(cuid())
  fullName           String
  email              String      @unique
  passwordHash       String
  mustChangePassword Boolean     @default(false)
  totpSecret         String?
  totpEnabled        Boolean     @default(false)
  role               UserRole
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  createdAt          DateTime    @default(now())

  // التنحية لا تحذف الحساب: تُعطّله وتُفرِغ المنصب لمن بعده، ويبقى سجله
  isActive      Boolean   @default(true)
  removedAt     DateTime?
  removalReason String?

  // رقم صفه الثابت في تبويب "الحسابات الإدارية" — يُحفظ أول مرة فقط ليُحدَّث
  // الصف نفسه بعدها بدل تكديس صف جديد عند كل تغيّر
  sheetRow          Int?
  passwordChangedAt DateTime?

  // بيانات صاحب الحساب الإداري — نفس ما يسجّله العضو قبل اختباره.
  // الفاوندر والتنفيذي إداريان قبل أن يكونا لقبين، فلهما سجلّ كغيرهما.
  phone              String?
  jobTitle           String?
  /// انظر `Gender` — يختاره صاحب الحساب في «بياناتي»
  gender             Gender?
  /// الصورة الشخصية — انظر `Member.avatarData`
  avatarData         String?
  /// ختمُ آخر تغييرٍ للصورة — انظر `Member.avatarVersion`
  avatarVersion      DateTime?
  specialization     String?
  section            String?
  profileCompletedAt DateTime?

  // البريد الترحيبي: متى وصله، وكم مرة أُعيد إرساله بطلبه
  /// ختمُ **القبول** — لا ختمُ المحاولة.
  ///
  /// **العطبُ الذي يُصلحه هذا الفصل، وهو عينُ الحادثة المُبلَّغ عنها:**
  /// كان هذا الحقلُ يُكتَب **قبل** الإرسال ليُحجَز حقُّ الإرسال مرّةً
  /// واحدة، ثم يُمسَح إن أخفق البريد. وبينهما نداءٌ شبكيٌّ إلى مزوّد
  /// البريد قد يَطول. فإن انقطع التنفيذُ في تلك اللحظة — مهلةُ لامبدا،
  /// أو استثناءٌ غيرُ متوقَّع — بقي الختمُ مكتوباً **ولم تُرسَل رسالة**.
  ///
  /// فينتج عنه ثلاثةُ أعراضٍ معاً، وهي التي رأيتَها:
  /// ١) الشيتُ يقول «✓ وصلت بطاقة الانضمام» ولم تصل.
  /// ٢) وزرُّ الإرسال يُردّ بـ«أُرسلت من قبل» إلى الأبد.
  /// ٣) ولا أثرَ في سجلّ البريد يُفسّر شيئاً.
  ///
  /// فصار الحجزُ في حقلٍ آخر (`welcomeClaimedAt`)، وهذا الحقلُ لا
  /// يُكتَب إلا بعد أن يَقبل المزوّدُ الرسالةَ فعلاً. فما يُقرأ في
  /// الشيت وفي الواجهة هو ما وقع، لا ما حوولت محاولتُه.
  welcomeEmailSentAt DateTime?
  /// حجزُ حقِّ الإرسال — ويَنقضي بمهلة.
  ///
  /// يُكتَب قبل الإرسال فيَمنع متسابقاً ثانياً، ويُمسَح بعده نجح أو
  /// أخفق. **ومهلتُه هي ما يَمنع القفلَ الأبديّ:** حجزٌ مضى عليه أكثرُ
  /// من `WELCOME_CLAIM_TTL_MS` يُعَدّ منقطعاً فيُدَّعى من جديد — فلا
  /// يُحبَس أحدٌ خارج بطاقته لأن لامبدا ماتت مرّةً.
  welcomeClaimedAt   DateTime?
  welcomeEmailCount  Int       @default(0)
  // آخر مرة نُبّه فيها لتفعيل التحقق الثنائي — حتى لا يتكرّر كل يوم
  totpNudgedAt       DateTime?

  invitesIssued   Invite[] @relation("InvitedBy")
  ticketsRaised   Ticket[] @relation("TicketRaisedBy")
  ticketsAssigned Ticket[] @relation("TicketTargetUser")
  ticketsResolved Ticket[] @relation("TicketResolvedBy")
  memberDateEdits MemberDateEdit[] @relation("MemberDateEditor")
  signatures      LeaderSignature[] @relation("SignatureOwner")
  signaturesApproved LeaderSignature[] @relation("SignatureApprover")
  terminationsDecided TerminationRequest[] @relation("TerminationDecider")
  approvalsPending    Ticket[]             @relation("TicketApprover")
  approvalsGranted    Ticket[]             @relation("TicketApprovedBy")
  approvalDecisions   ApprovalDecision[]   @relation("ApprovalDecider")

  // نظامُ التنفيذ الاستراتيجي
  goalsAccountable StrategicGoal[]       @relation("GoalAccountable")
  goalsOwned       StrategicGoal[]       @relation("GoalOwner")
  milestonesOwned  Milestone[]           @relation("MilestoneOwner")
  objectivesLed    DepartmentObjective[] @relation("ObjectiveLead")
  tasksOwned       PlanTask[]            @relation("TaskOwnerUser")
}

/// دعوة مقفلة بالاسم والإيميل — لا تسجيل عام. targetRole يحدد المسار:
/// عضو قسم (يدعوه أدمن قسمه) / قائد قسم (يدعوه المؤسس أو التنفيذي) / تنفيذي (المؤسس فقط)
model Invite {
  id           String           @id @default(cuid())
  token        String           @unique @default(cuid())
  fullName     String
  email        String
  targetRole   InviteTargetRole @default(member)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  testTrackId  String
  testTrack    TestTrack        @relation(fields: [testTrackId], references: [id])
  invitedById  String
  invitedBy    User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status       InviteStatus     @default(open)
  /// وصول بريد الدعوة: متى وصل، وكم مرّة حُوِلت.
  ///
  /// لولا هذا لا يُعرف الفرق بين دعوةٍ وصلت ولم يفتحها صاحبها ودعوةٍ لم
  /// تصل أصلاً — والأولى تُنتظَر والثانية تُعاد. والإعادة لا تُنشئ دعوةً
  /// ثانية: `resetMemberCredentials` يُصدر رمزاً جديداً للدعوة نفسها.
  emailSentAt  DateTime?
  emailAttempts Int             @default(0)
  createdAt    DateTime         @default(now())

  member Member?
}

/// مرشح مرّ بدورة دعوة/اختبار — لأي مستوى (عضو/قائد قسم/تنفيذي). بعد الاعتماد
/// يصبح له حساب دخول دائم (مباشرة كـ Member للأعضاء، أو يُنشأ له User للقيادة)
model Member {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  phone           String?
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  jobTitle        String?
  /// انظر `Gender` — يختاره صاحبه عند استكمال بياناته أو من لوحته
  gender          Gender?
  /// الصورة الشخصية — صورةٌ واحدة معتمدة لكل شخص، مُوحَّدة عند الاستلام.
  ///
  /// تُخزَّن data URL كما يُخزَّن توقيع القائد: لا مخزن ملفّات في المنصة،
  /// والصورة مُصغَّرةٌ مُوحَّدةُ الأبعاد عند الرفع فحجمها معلوم.
  avatarData      String?
  /// ختمُ آخر تغييرٍ للصورة — ويؤدّي عملَين لا عملاً واحداً.
  ///
  /// **لماذا وُجد أصلاً:** الصورة تُقرأ في الهيكل وفي كل بطاقة، وكانت
  /// تُرسَل data URL داخل الصفحة نفسها — فقِستُ صفحةَ الهيكل فوجدتُها
  /// ٣١٩٩ ك.ب منها ٢٤٥٧ ك.ب وثيقةٌ واحدة، وصورةً واحدةً بـ١٢٠٥ ك.ب.
  /// فصارت تُطلَب من مسارٍ يُخزَّن في المتصفّح، والصفحةُ لا تحمل إلا
  /// رابطاً. ولكي يَصلح الرابط للتخزين الأبديّ لزمه ختمٌ يتغيّر إذا
  /// تغيّرت الصورة — وإلا بقي المتصفّح يَعرض القديمة بعد الاستبدال.
  ///
  /// **والعملُ الثاني:** يقول «أله صورة؟» بلا جلبِ الصورة. فالقوائم
  /// تَسأل الختمَ ولا تَسأل البيانات، فلا تَحمل ميجاباتٍ لتَعرف حرفاً.
  avatarVersion   DateTime?
  joinDate        DateTime       @default(now())
  /// تاريخ الانضمام الفعلي لتَـــلاقِ — لا تاريخ إنشاء حسابه.
  ///
  /// بعضهم انضمّ قبل أن توجد المنصة، فتاريخُ حسابه ليس تاريخَ انضمامه.
  /// وهي خمسة تواريخ لا تُخلَط: إنشاء الحساب (`createdAt`)، والانضمام
  /// التنظيمي (هذا)، وبداية التكليف الإداري (`decidedAt`)، ونهايته
  /// (`endDate`)، وإصدار الشهادة (`certificateIssuedAt`).
  ///
  /// ويبقى `null` لمن لا يُعرف تاريخه: لا يُخترَع تاريخٌ لمن جُهل أمره.
  orgJoinDate     DateTime?
  testScore       Int?
  testStatus      TestStatus     @default(not_started)
  approvalStatus  ApprovalStatus @default(pending_review)
  assignedAdminId String?
  inviteId        String         @unique
  invite          Invite         @relation(fields: [inviteId], references: [id])
  createdAt       DateTime       @default(now())
  decidedAt       DateTime?

  // بيانات الدخول — تُنشأ لحظة إنشاء الحساب (قبل الاختبار)، فالمرشّح يدخل
  // بالرمز المؤقت أولاً ثم يغيّره ثم يبدأ اختباره داخل المنصة
  passwordHash        String?
  mustChangePassword  Boolean   @default(false)
  credentialsIssuedAt DateTime?
  firstLoginAt        DateTime?
  isActive            Boolean   @default(true)
  warningsCount       Int       @default(0)
  terminatedAt        DateTime?
  exitReason          String?
  certificateIssuedAt DateTime?
  // إصدار الشهادة وتسليمها حدثان لا حدث: الإصدار مرّة واحدة لكلّ انتهاء
  // (فلا تُصدَر شهادتان لمسيرةٍ واحدة)، والتسليم يُعاد إن فشل البريد.
  // ولو كان الحدث واحداً لمنع فشلُ الإرسال إعادةَ المحاولة أبداً.
  certificateSentAt   DateTime?
  // شهادة الثلاثة أشهر — حدثٌ مستقلٌّ عن شهادة الإنهاء، له ختماه.
  // `appreciationDueAt` يُسجَّل يوم الاستحقاق كما حُسب، لا يوم الإرسال:
  // فمن أُرسلت له متأخّرةً (تعطّل الكنس يوماً) يبقى في السجل أنه
  // استحقّها في موعدها.
  appreciationDueAt   DateTime?
  appreciationIssuedAt DateTime?
  appreciationSentAt  DateTime?
  sheetRow            Int?

  // بيانات يسجّلها المرشّح بنفسه قبل بدء الاختبار — تُكتب في الشيت فوراً
  specialization     String?
  section            String?
  profileCompletedAt DateTime?

  // إعادة فتح الاختبار بعد عدم الاجتياز: من أعادها، ومتى، وعلى أي أساس
  testReopenCount Int       @default(0)
  testReopenedAt  DateTime?
  testReopenNote  String?

  // البريد الترحيبي: متى وصله، وكم مرة أُعيد إرساله بطلبه
  /// ختمُ **القبول** — لا ختمُ المحاولة.
  ///
  /// **العطبُ الذي يُصلحه هذا الفصل، وهو عينُ الحادثة المُبلَّغ عنها:**
  /// كان هذا الحقلُ يُكتَب **قبل** الإرسال ليُحجَز حقُّ الإرسال مرّةً
  /// واحدة، ثم يُمسَح إن أخفق البريد. وبينهما نداءٌ شبكيٌّ إلى مزوّد
  /// البريد قد يَطول. فإن انقطع التنفيذُ في تلك اللحظة — مهلةُ لامبدا،
  /// أو استثناءٌ غيرُ متوقَّع — بقي الختمُ مكتوباً **ولم تُرسَل رسالة**.
  ///
  /// فينتج عنه ثلاثةُ أعراضٍ معاً، وهي التي رأيتَها:
  /// ١) الشيتُ يقول «✓ وصلت بطاقة الانضمام» ولم تصل.
  /// ٢) وزرُّ الإرسال يُردّ بـ«أُرسلت من قبل» إلى الأبد.
  /// ٣) ولا أثرَ في سجلّ البريد يُفسّر شيئاً.
  ///
  /// فصار الحجزُ في حقلٍ آخر (`welcomeClaimedAt`)، وهذا الحقلُ لا
  /// يُكتَب إلا بعد أن يَقبل المزوّدُ الرسالةَ فعلاً. فما يُقرأ في
  /// الشيت وفي الواجهة هو ما وقع، لا ما حوولت محاولتُه.
  welcomeEmailSentAt DateTime?
  /// حجزُ حقِّ الإرسال — ويَنقضي بمهلة.
  ///
  /// يُكتَب قبل الإرسال فيَمنع متسابقاً ثانياً، ويُمسَح بعده نجح أو
  /// أخفق. **ومهلتُه هي ما يَمنع القفلَ الأبديّ:** حجزٌ مضى عليه أكثرُ
  /// من `WELCOME_CLAIM_TTL_MS` يُعَدّ منقطعاً فيُدَّعى من جديد — فلا
  /// يُحبَس أحدٌ خارج بطاقته لأن لامبدا ماتت مرّةً.
  welcomeClaimedAt   DateTime?
  welcomeEmailCount  Int       @default(0)

  // حوكمة التنحي: لا ينتهي أحد فجأة ولا يبقى معلّقاً بلا تاريخ.
  // يُنحّيه قائده، فيتوقّف عمله ويُحدَّد تاريخ انتهائه، ثم لا تُغلق
  // تجربته حتى تُسلَّم شهادته ويُصمَّم وداعه — ويُسجَّل كل ذلك بتاريخه.
  stepDownAt          DateTime?
  stepDownByName      String?
  endDate             DateTime?
  farewellDesignAt    DateTime?
  // إغلاق التجربة: تُرسل رسالة الشكر الأخيرة، ولا يصله بعدها بريد أبداً
  offboardingClosedAt DateTime?
  noFurtherEmail      Boolean   @default(false)

  testAttempts    TestAttempt[]
  requests        Request[]       @relation("LinkedMemberRequests")
  warnings        MemberWarning[]
  tickets         Ticket[]
  ticketsAssigned Ticket[]        @relation("TicketTargetMember")
  dateEdits       MemberDateEdit[]
  terminationRequests TerminationRequest[]
  tasksOwned      PlanTask[]      @relation("TaskOwnerMember")

  // الكنس اليومي يسأل: من لم تصله شهادة تقديره؟ فيُجاب رخيصاً
  @@index([appreciationSentAt])
}

model TestAttempt {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  answers     Json
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())
}

/// بنك أسئلة قابل للتعديل حسب المستوى: اختبار أعضاء قسم معيّن (يعدّله أدمن ذلك
/// القسم)، اختبار قادة الأقسام (يعدّله التنفيذي), اختبار التنفيذيين (يعدّله المؤسس فقط)
model TestTrack {
  id           String         @id @default(cuid())
  scope        TestTrackScope
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  createdAt    DateTime       @default(now())

  questions TestQuestion[]
  invites   Invite[]

  @@unique([scope, departmentId])
}

model TestQuestion {
  id           String    @id @default(cuid())
  trackId      String
  track        TestTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json
  correctIndex Int
  order        Int       @default(0)
}

/// تنبيه يصدره أدمن القسم لعضو معتمد — ٣ تنبيهات تؤدي لاستبعاد تلقائي
model MemberWarning {
  id             String    @id @default(cuid())
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id])
  issuedByUserId String
  reason         String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
}

/// طلب داخلي بين الأقسام — مالك واحد واضح (targetDepartment) لكل طلب
model Request {
  id                 String        @id @default(cuid())
  type               RequestType
  createdById        String?
  targetDepartmentId String
  targetDepartment   Department    @relation("TargetDepartmentRequests", fields: [targetDepartmentId], references: [id])
  status             RequestStatus @default(new)
  dueDate            DateTime?
  linkedMemberId     String?
  linkedMember       Member?       @relation("LinkedMemberRequests", fields: [linkedMemberId], references: [id])
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

/// تذكرة يرفعها عضو (مثال: لم يصله البانر الترحيبي). تصعيد تلقائي صارم إذا لم
/// يُستجب خلال المهلة: القسم المستهدف (يومان) ← قائد قسم العضو (يومان) ← الإدارة التنفيذية
model Ticket {
  id                 String       @id @default(cuid())
  ticketNumber       Int          @unique @default(autoincrement())
  subject            String
  description        String
  // صاحب التذكرة: عضو أو حساب إداري — واحد منهما لا كلاهما
  memberId           String?
  member             Member?      @relation(fields: [memberId], references: [id])
  raisedByUserId     String?
  raisedByUser       User?        @relation("TicketRaisedBy", fields: [raisedByUserId], references: [id])
  // الوجهة: قسم كامل أو شخص بعينه — واحدة منهما
  targetDepartmentId String?
  targetDepartment   Department?  @relation("TicketTargetDepartment", fields: [targetDepartmentId], references: [id])
  targetUserId       String?
  targetUser         User?        @relation("TicketTargetUser", fields: [targetUserId], references: [id])
  targetMemberId     String?
  targetMember       Member?      @relation("TicketTargetMember", fields: [targetMemberId], references: [id])
  /// رابط مرفق اختياري — منشور، ملف، أو اجتماع يخصّ التذكرة
  linkUrl            String?
  status             TicketStatus @default(open)
  stage              TicketStage  @default(department)
  stageDueAt         DateTime
  /// الموعد الأول كما حُدِّد لحظة الرفع — لا يتبدّل بالتصعيد أبداً.
  ///
  /// `stageDueAt` يُجدَّد عند كل تصعيد، فيُفقَد الموعد الأصلي. وبدونه
  /// لا يُقاس التأخّر إلا استنتاجاً من المرحلة («إن صُعِّدت فقد تأخّرت»)
  /// — وهو استنتاجٌ صحيحٌ تقريباً وهشٌّ: أيُّ مسٍّ للمرحلة يُفسد عمود
  /// «متأخرة؟» في الإكسل. فصار القياس على موعدٍ ثابت لا على مرحلةٍ
  /// متحرّكة.
  firstDueAt         DateTime?
  resolutionNote     String?
  resolvedAt         DateTime?
  /// من أغلقها — الإغلاق تصرّفٌ يُنسَب لصاحبه، لا حدثٌ بلا فاعل
  resolvedByUserId   String?
  resolvedByUser     User?        @relation("TicketResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  /// طلبُ اعتمادٍ إداري: اختياريٌّ على التذكرة لا لازمٌ لها.
  ///
  /// `null` يعني تذكرةً عادية — وهي الأكثر. ولو جُعل الاعتماد لازماً لكل
  /// تذكرة لصار على كل سؤالٍ يوميٍّ بابُ موافقة.
  approvalState      ApprovalState?
  approvalKind       ApprovalKind?
  /// المعتمِد المنتظَر الآن. يتبدّل في المسار المتسلسل إلى الذي يليه.
  approverUserId     String?
  approverUser       User?        @relation("TicketApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  /// المسار المتسلسل: معرّفات المعتمِدين بالترتيب، وأوّلُهم هو
  /// `approverUserId` ابتداءً. فارغٌ يعني اعتماداً واحداً.
  approvalChain      String[]     @default([])
  /// المرحلة الحالية في المسار — تبدأ عند ١
  approvalStep       Int          @default(1)
  /// الاعتماد النهائي: يُكتب حين تكتمل كل الموافقات المطلوبة لا أوّلُها
  approvedAt         DateTime?
  approvedByUserId   String?
  approvedByUser     User?        @relation("TicketApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  /// كم مرّة رُدَّت للتعديل — يُقرأ تاريخاً مع `decisions`
  returnCount        Int          @default(0)
  decisions          ApprovalDecision[]

  /// سُحبت بطلب صاحبها — إغلاقٌ ليس إجابة.
  ///
  /// التذكرة التي رفعها صاحبها ثم بلغت آخر السلسلة ولم يكن في المرحلة
  /// الأخيرة أحدٌ غيره، كانت تقف إلى الأبد: الوحيد المصرَّح له هو
  /// صاحبها، وصاحبها لا يُجيب نفسه. فصار له أن يسحبها — وهذا يُسجَّل
  /// سحباً لا حلاً، فلا يُقال في السجل إن أحداً أجاب وقد لم يُجب.
  withdrawnAt        DateTime?
  /// إعادة الفتح: لا تقع إلا بتصرّفٍ صريح مُصرَّح به، ويُسجَّل كم مرّة
  reopenCount        Int          @default(0)
  reopenedAt         DateTime?
  /// ═══ التذكرةُ حين تكون اقتراحَ تحسين ═══
  ///
  /// **واللجنةُ قسمٌ له أبٌ، والتحسينُ تذكرةٌ لها نوع.** ولو بُني نظامٌ
  /// ثانٍ للتحسينات لصار للمنصة طابورانِ وبريدانِ وإكسلانِ ومسارا
  /// اعتمادٍ — وكلُّ إصلاحٍ في أحدهما يُنسى في الآخر. فالتحسينُ تذكرةٌ
  /// تَرث كلَّ ذلك، ويُميّزها حقلٌ واحد.
  ///
  /// و`null` ليست نقصاً: هي علامةُ التذكرة العادية — وهي الأكثر.
  improvementKind    ImprovementKind?
  /// الحالةُ التفصيلية في مسار التحسين.
  ///
  /// و`status` يبقى الإسقاطَ الخشن الذي تَقرؤه طبقةُ التصعيد والإكسل:
  /// تُكتَبان معاً في موضعٍ واحد (`advanceImprovement`) فلا تَفترقان.
  improvementState   ImprovementState?
  /// سياقُ الصفحة كما التُقِط لحظةَ الرفع — JSON.
  ///
  /// **ولماذا يُلتقَط ولا يُسأل عنه:** «في أيّ صفحة؟ وبأيّ مقاس؟ وبأيّ
  /// سمة؟» أسئلةٌ يَعرف المتصفّحُ جوابَها ولا يَعرفه صاحبُ الملاحظة
  /// بدقّة. وكلُّ سؤالٍ يُسأل بابٌ يَنصرف عنده من كان سيُبلغ.
  ///
  /// ولا يَحمل شيئاً يَخصّ غيرَ من رفعه، ولا نصَّ صفحةٍ ولا بيانات.
  pageContext        String?
  /// أقرّ صاحبُ الملاحظة أن الإصلاح وقع — أو قال إنه لم يقع.
  ///
  /// **ولا يُغلَق تحسينٌ بإقرار من أصلحه وحده:** من يَرى العطبَ هو من
  /// يَشهد بزواله. فالحالةُ تَقف عند `awaiting_user` حتى يُجيب.
  userVerifiedAt     DateTime?
  userRejectedAt     DateTime?
  /// الفكرةُ حين تصير عملاً: مهمّةٌ في أسبوعٍ أو هدفٌ في الخطة
  convertedTaskId    String?
  convertedGoalId    String?

  sheetRow           Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // الكنس يسأل: من تأخّر وما يزال مفتوحاً؟ فيُجاب بفهرسٍ لا بمسحٍ كامل
  @@index([status, stageDueAt])
  /// وصندوقُ التحسينات يسأل: ما نوعُها وما حالتُها؟ — بفهرسٍ لا بمسح
  @@index([improvementKind, improvementState])
}

/// نوعُ اقتراح التحسين — ثلاثةٌ لا أكثر.
///
/// **والقائمةُ قصيرةٌ عمداً:** كلُّ خيارٍ زائدٍ وقفةٌ يَتردّد عندها من
/// كان سيُبلغ، وكلُّ وقفةٍ تُفقِد ملاحظة. وهذه الثلاثةُ تَستوعب ما
/// يُبلَّغ عنه فعلاً: شيءٌ معطوب، أو شيءٌ غامض، أو شيءٌ يُقترَح.
enum ImprovementKind {
  /// عطبٌ: شيءٌ لا يعمل كما يُنتظَر
  bug
  /// غموضٌ: يعمل لكنّه لا يُفهَم
  confusing
  /// فكرةٌ: لا عطبَ فيه، ويُقترَح أحسنُ منه
  idea
}

/// مسارُ التحسين من الوصول إلى الإغلاق.
///
/// **ولا يُغلَق إلا بشهادة صاحبه:** بين `in_progress` و`resolved` تقف
/// `awaiting_user` — من رأى العطبَ هو من يَشهد بزواله. فلا يُقال
/// «أُصلح» ثم يُفتَح الباب فيُرى كما كان.
enum ImprovementState {
  /// وصل ولم يُقرأ بعد
  new
  /// قُرئ وصُنِّف، وعُرف أهو عملٌ أم لا
  triaged
  /// يُعمَل عليه الآن
  in_progress
  /// أُصلح ويَنتظر أن يُجرّبه صاحبُه
  awaiting_user
  /// شهد صاحبُه أنه زال
  resolved
  /// أُغلق: إمّا بعد الحلّ، أو لأنه لن يُنفَّذ — والسببُ مكتوب
  closed
}

/// جمهور الإعلان — يحدد من يراه على لوحته
enum AnnouncementAudience {
  everyone
  leadership
  department
}

/// إعلان داخلي ينشره المؤسس أو التنفيذي أو مسؤول التشغيل — يظهر لجمهوره
/// المحدد على رأس لوحته، وهو قناة التواصل الرسمية بدل الرسائل المتفرقة
model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  audience     AnnouncementAudience @default(everyone)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  authorId     String
  authorName   String
  createdAt    DateTime             @default(now())
  pinnedUntil  DateTime?

  /// رابط اجتماع (Google Meet وغيره) — الإدارة العليا وحدها تضعه
  meetingUrl String?
  /// رابط مرفق عام: منشور يُطلب التفاعل معه، نموذج، أو مستند
  linkUrl    String?
  linkLabel  String?

  // هل نُسخ الإعلان إلى بريد الجميع، لا على المنصة وحدها
  sentByEmail     Boolean @default(false)
  emailRecipients Int     @default(0)

  // الإعلانات تُقرأ دائماً بالأحدث أولاً — الفهرس مصرَّح به هنا لأنه
  // أُنشئ يدوياً من قبل ولم يكن في المخطط، فكاد يُسقَط عند أول ترحيل
  @@index([createdAt(sort: Desc)])
}

/// يمنع هجمات التخمين وحشو بيانات الاعتماد — يتتبع محاولات الدخول الفاشلة لكل
/// بريد إلكتروني، ويقفل الحساب مؤقتاً بعد عدد محاولات محدد
model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// رمز استعادة كلمة المرور — يُخزَّن مُجزّأً (hash) لا نصاً صريحاً: من يطّلع
/// على القاعدة لا يستطيع انتحال طلب استعادة. صالح لمرة واحدة ولمدة قصيرة.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// سجل كل رسالة تُرسلها المنصة. كان هذا السجل يعيش في Google Sheet وحده،
/// فلا تستطيع المنصة عرضه ولا البحث فيه، ويضيع كله إن تعطّل الاتصال بالشيت.
/// الآن يُكتب هنا أولاً — وهو المصدر — ثم يُنسخ إلى الشيت.
model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  kind      String
  subject   String
  status    String
  createdAt DateTime @default(now())

  /// ═══ جوابُ المزوّد — وهذا ما كان ناقصاً، وبه وقع العطب ═══
  ///
  /// **الحادثة:** انضمّ عضوٌ فلم تصله بطاقةُ الانضمام، وضغط المسؤولُ
  /// «أرسلها» فظهر له «تعذّر إرسال البريد الآن». ثم لم يَعرف أحدٌ لماذا:
  /// لا في المنصة ولا في الشيت ولا في السجلّ — لأن السجلّ كان يَحفظ
  /// «فشل الإرسال» ولا يَحفظ **سببَ** الفشل. وسجلُّ Vercel لا يُبقي
  /// شيئاً بعد ساعة على الخطة المجانية. فضاع الجواب الوحيد الذي يُفيد.
  ///
  /// فصار يُحفَظ هنا: المزوّدُ إمّا قَبِل فأعطى معرّفاً، أو رفض فأعطى
  /// اسمَ الخطأ ونصَّه. وكلاهما يُقرأ في المنصة بعد شهر.
  ///
  /// **ولا يُحفَظ سرٌّ هنا:** المفتاحُ لا يَظهر في جواب المزوّد، والنصُّ
  /// المحفوظُ مقصوصٌ على ٥٠٠ حرف فلا يَبتلع أثراً كاملاً.
  providerId    String?
  failureKind   String?
  failureDetail String?

  /// وكم مرّةً حوولت هذه الرسالةُ إلى هذا المستلِم — لتُقرأ إعادةُ
  /// المحاولة تاريخاً لا حدثاً منفرداً
  attempt   Int      @default(1)

  @@index([createdAt])
  @@index([recipient])
  /// ولوحةُ التشخيص تسأل: ما آخرُ ما فشل من نوعٍ بعينه؟
  @@index([kind, status])
}

/// رمز الدخول لمرة واحدة. يُرسَل إلى بريد صاحب الحساب بعد صحّة كلمة
/// المرور، فلا يكفي معرفةُ الكلمة وحدها للدخول: يلزم الوصول إلى البريد.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// سجلّ تعديل تواريخ العضوية — تصحيحُ تاريخٍ تصرّفٌ يُراجَع لا يُفترَض.
///
/// المؤسس يصحّح تاريخ انضمامٍ تنظيميٍّ لمن سبق المنصة. ولأن التواريخ
/// تحكم الاستحقاقات (شهادة الثلاثة أشهر مثلاً)، يُحفظ ما كان وما صار
/// ومن غيّره ومتى — فلا يُقال «لماذا استحقّ هذا مبكراً؟» بلا جواب.
model MemberDateEdit {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// اسم الحقل كما في النموذج: `orgJoinDate` وغيره
  field     String
  previous  DateTime?
  next      DateTime?
  /// من عدّله — يبقى اسمه ولو حُذف حسابه لاحقاً
  editedById   String?
  editedByUser User?  @relation("MemberDateEditor", fields: [editedById], references: [id], onDelete: SetNull)
  editedByName String
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

/// حالة توقيع القائد في مساره من الطلب إلى الاعتماد
enum SignatureStatus {
  /// طُلب منه ولم يرفع بعد
  requested
  /// رفعه وينتظر اعتماد الإدارة
  submitted
  /// اعتُمد — وهو وحده ما يُرسَم على الشهادات
  approved
  /// رُفض بسبب مكتوب
  rejected
  /// بطل لأن صاحبه لم يبقَ في منصبه
  superseded
}

/// توقيع قائد — يُرسَم على الشهادات التي يُوقّعها.
///
/// **ولا يُعاد استعمال توقيع قائدٍ سابق لخَلَفِه أبداً.** التوقيع مرتبط
/// بصاحبه ودوره وقسمه، لا بالمنصب وحده. فمن خرج بطل توقيعه
/// (`superseded`) ولم يُورَّث، ومن جاء طُلب منه توقيعُه هو. وتوريثُه
/// انتحالٌ: شهادةٌ تحمل توقيع من لم يكن في المنصة يوم صدورها.
///
/// والشهادات الصادرة تبقى صحيحة بتوقيعاتها: `certificateIssuedAt` يُثبت
/// وقتها، وبطلانُ التوقيع لاحقاً لا يُبطل ما مضى.
model LeaderSignature {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("SignatureOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// الدور والقسم حين طُلب التوقيع — فلا يُستعمل توقيعُ قائدٍ لقسمٍ آخر
  role         String
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  status       SignatureStatus @default(requested)
  /// صورة التوقيع كـdata URL — صغيرةٌ بطبعها، ولا مخزن ملفّات في المنصة
  imageData    String?
  requestedAt  DateTime        @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?           @relation("SignatureApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?
  rejectionNote String?
  supersededAt DateTime?
  /// متى ذُكِّر صاحبه آخر مرّة — فلا يُذكَّر كل يوم
  remindedAt   DateTime?

  createdAt    DateTime        @default(now())

  /// لكل شخصٍ في دورٍ وقسمٍ توقيعٌ واحدٌ حيّ
  @@index([userId, status])
  @@index([role, departmentId, status])
}

/// حالة طلب إنهاء فترة الإدارة
enum TerminationStatus {
  /// رفعه صاحبه وينتظر قرار مسؤوله
  submitted
  /// طلب المسؤول لقاءً قبل أن يقرّر — **وليس قراراً**
  meeting_requested
  /// وُوفق عليه: ينتهي بتاريخٍ محدّد
  approved
  /// رُفض بتفسيرٍ مكتوب
  rejected
  /// وُوفق عليه وحلّ تاريخُه ونُفِّذ الخروج
  effective
  /// سحبه صاحبه قبل القرار
  withdrawn
}

/// «طلب إنهاء فترة الإدارة في تَـــلاقِ» — يرفعه صاحبه لا تُقرّره عنه.
///
/// والرفع لا يُعطّل أحداً: من طلب الإنهاء يبقى على عمله حتى يُقرّر
/// مسؤولُه وتحلّ مهلته. ولو عُطِّل بالرفع لصار الطلب عقوبةً يخشاها من
/// يحقّ له طلبُه، ولأمكن أن يُخرِج نفسَه بضغطةٍ بلا مراجعة.
///
/// ولقاءُ المسؤول ليس قراراً: قد يُقنعه بالبقاء أو يتفهّم فيوافق —
/// وفي الحالتين القرار يأتي بعده لا معه.
model TerminationRequest {
  id          String            @id @default(cuid())
  memberId    String
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// التكليف المعنيّ كما كان وقت الطلب — فلا يُقرأ لاحقاً تكليفاً آخر
  assignmentLabel String
  /// سبب الطلب بكلمات صاحبه
  reason      String
  status      TerminationStatus @default(submitted)

  submittedAt DateTime          @default(now())
  /// التاريخ المقترح للانتهاء — يقترحه صاحبه ويُثبته القرار
  requestedEndDate DateTime?

  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?             @relation("TerminationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedByName String?
  /// تفسير الرفض، أو ملاحظة الموافقة، أو ما قيل في طلب اللقاء
  decisionNote String?

  /// متى طُلب اللقاء وما موعده — ولا يُعدّ قراراً
  meetingRequestedAt DateTime?
  meetingNote  String?

  /// متى نُفِّذ الخروج فعلاً — بعد الموافقة وحلول التاريخ
  effectiveAt DateTime?

  createdAt   DateTime          @default(now())

  @@index([memberId, status])
  @@index([status, submittedAt])
}

/// عدّادُ نتائج التذاكر — يبقى بعد أن تُؤرشَف التذاكر نفسها.
///
/// التذاكر المغلقة تُحال إلى الإكسل أسبوعياً لتبقى المنصة خفيفة، فلو
/// حُسبت التقارير من صفوفها لصار التقرير أسبوعاً واحداً ثم يُفرَّغ. ولو
/// أُبقيت الصفوف من أجل التقرير لعاد الحمل الذي أُريد تخفيفه.
///
/// فالنتيجة تُعَدّ لحظةَ الإغلاق في صفٍّ واحدٍ لكل نطاق — قسمٍ أو شخص —
/// ويبقى العدّاد وإن زالت التذاكر. وهو صغيرٌ ثابت: صفٌّ لكل نطاق لا صفٌّ
/// لكل تذكرة.
model TicketTally {
  id    String @id @default(cuid())
  /// النطاق: `dept:<id>` أو `user:<id>`
  scope String @unique
  /// أُغلقت قبل موعدها الأصلي
  onTime    Int @default(0)
  /// أُغلقت بعده
  late      Int @default(0)
  /// سحبها صاحبها — لا تُحسب التزاماً ولا تأخّراً
  withdrawn Int @default(0)
  updatedAt DateTime @updatedAt
}

/// نوعُ المادة في مركز الخطط: ملفٌّ مرفوع أو رابطٌ خارجي
enum PlanItemKind {
  file
  link
}

/// نبذةُ مركز الخطط — صفٌّ واحدٌ لا جدولُ صفوف.
///
/// النبذةُ وثيقةٌ واحدةٌ تُحرَّر لا سجلٌّ يُضاف إليه، فصفُّها واحدٌ
/// بمعرّفٍ ثابت (`main`) يُكتب فوقه. ولو كانت صفوفاً لاحتاجت سؤالاً عن
/// «أيُّها المعروضة الآن؟» — سؤالٌ لا جواب له إلا حقلٌ آخر.
model PlanLibrary {
  id            String   @id @default("main")
  /// «من نحن، ولماذا، وكيف» — نصٌّ حرٌّ يُعرَض فوق الملفات
  intro         String   @default("")
  /// عنوانٌ للمركز يُغيَّر من الواجهة، فلا يُنشَر تغييرُ كلمة
  heading       String   @default("خطط تَـــلاقِ")
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

/// مادةٌ في مركز الخطط: ملفٌّ يُرفَع أو رابطٌ يُشار إليه.
///
/// **والملفُّ يُخزَّن في القاعدة لا في مخزنٍ خارجي.** وهذا موافقٌ لما
/// في المنصة أصلاً: الصورةُ الشخصية وتوقيعُ القائد يُخزَّنان فيها
/// كذلك، ولا مخزنَ ملفّاتٍ هنا. والحدُّ مفروضٌ (`MAX_PLAN_FILE_BYTES`)
/// فلا يُثقَل صفٌّ بما لا تحتمله قراءته، ومن كان ملفُّه أكبر فله
/// الرابط — وهو السبب في وجود النوعَين لا الترف.
///
/// **و`data` لا تُقرأ في القوائم أبداً:** القائمةُ تُنتقى حقولُها
/// صراحةً، والبايتاتُ لا تُطلَب إلا في مسار التنزيل وحده. ولو قُرئت مع
/// القائمة لَحُمِّلت كلُّ الملفّات في كل فتحةِ صفحة.
model PlanDoc {
  id             String       @id @default(cuid())
  /// ترتيبُها كما رتّبه المؤسس أو التنفيذي — رقمٌ يُقرأ ويُبدَّل
  order          Int
  title          String
  /// سطرٌ تحت العنوان يقول ما فيه — اختياري
  note           String?
  kind           PlanItemKind

  fileName       String?
  mimeType       String?
  byteSize       Int?
  data           Bytes?

  linkUrl        String?

  uploadedById   String?
  uploadedByName String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([order])
}

// ═══════════════════════════════════════════════════════════════════
//  نظامُ التنفيذ الاستراتيجي: هدفٌ ← محطةٌ شهرية ← هدفُ قسم ← أسبوعُ
//  تنفيذٍ ← مهمّةٌ ← تسليمٌ ← تحقُّقُ التنفيذي ← مراجعةُ السبت.
//
//  **وأهمُّ قرارٍ فيه كلِّه:** المهمّةُ **صفٌّ واحدٌ يَعبر الأسابيع**، لا
//  صفٌّ جديدٌ كل أسبوع. فما لم يكتمل يبقى هو هو — بمعرّفه وموعده الأصلي
//  وصاحبه وتاريخه — ويُنقَل إلى خطة الأسبوع التالي ويُعَدّ ترحيلُه.
//  ولو أُنشئ له صفٌّ جديدٌ لانقطع تاريخُه، ولَبدا في التقارير عملاً
//  جديداً في كل أسبوع — وهذا بالضبط ما يُخفي التأخّر.
// ═══════════════════════════════════════════════════════════════════

/// أولويةُ العمل — تُقرأ ويُرتَّب بها، ولا تُغيّر الصلاحيات
enum WorkPriority {
  critical
  high
  normal
  low
}

/// حالةُ الهدف الاستراتيجي في مساره من الاقتراح إلى الحكم عليه
enum GoalStatus {
  /// يُكتَب ولم يُرسَل بعد
  draft
  /// اقترحه قائدُ قسمٍ أو كُتب وأُرسل — ينتظر اعتماد الإدارة
  proposed
  /// اعتُمد: صار التزاماً تنظيمياً
  approved
  /// رُدّ بسببٍ مكتوب
  rejected
  /// اعتُمد وبدأ العمل عليه
  active
  /// تحقّق بمعاييره
  achieved
  /// انقضى موعدُه ولم يتحقّق — ويبقى مكتوباً لا يُمحى
  missed
  /// أُلغي بقرارٍ مسجَّل
  cancelled
}

/// حالةُ هدف القسم أو المحطة الشهرية
enum ObjectiveStatus {
  proposed
  approved
  rejected
  active
  at_risk
  done
  missed
  cancelled
}

/// حالةُ **فترة** التنفيذ الأسبوعية — وهي تنظيميةٌ لا قسمية.
///
/// فتحُ الأسبوع قرارُ الإدارة لا حدثُ تقويم: لا يُفتَح لأن الساعة بلغت
/// السبت، بل لأن المراجعة تمّت وأُذن بالفتح صراحةً.
enum PeriodState {
  /// تُبنى خططُ الأقسام فيها
  draft
  /// رُفعت للمراجعة التنفيذية
  submitted
  /// اعتُمدت للعرض في اجتماع السبت
  approved_for_review
  /// الاجتماع قائمٌ والمراجعةُ لم تكتمل
  awaiting_review
  /// اكتملت المراجعة وتنتظر إذن الفتح
  awaiting_opening
  /// مفتوحةٌ للتنفيذ — وهي وحدها التي يُكتَب فيها
  open
  /// أُغلقت ورُحِّل ما لم يكتمل
  closed
  /// أُعيد فتحُها باستثناءٍ مسجَّل
  reopened
}

/// حالةُ خطة قسمٍ داخل فترة
enum WeekPlanState {
  draft
  submitted
  approved
  returned
}

/// حالةُ تنفيذ المهمّة — **منفصلةٌ عن التأخّر**.
///
/// التأخّرُ يُحسَب من الموعد لا يُخزَّن حالةً: مهمّةٌ «قيد التنفيذ»
/// ومتأخّرةٌ معاً حالٌ واقعة، ولو جُعل التأخّرُ حالةً لأزاح ما قبله
/// فلا يُعرَف أهي تُنفَّذ أم متوقّفة.
enum TaskExecState {
  not_started
  in_progress
  /// رُفع تسليمُها وتنتظر تحقّق التنفيذي — وليست مكتملة
  submitted
  /// تحقّق منها التنفيذي: وهذه وحدها تُحسَب إنجازاً
  verified
  /// رُدَّت للتصحيح بملاحظات
  returned
  /// حُكم عليها بعدم الاكتمال في المراجعة
  incomplete
  /// متوقّفةٌ على معوّقٍ أو تبعيّة
  blocked
  /// أُسقط الالتزام بقرارٍ مُصرَّح به — **ولا يُحسَب إنجازاً**
  waived
  /// أُلغيت
  cancelled
  /// حلّ محلَّها التزامٌ آخر
  superseded
  /// أُجّلت إلى محطةٍ لاحقة بقرار
  deferred
}

/// قرارُ المراجعة على تسليمٍ أو مهمّة
enum ReviewDecisionKind {
  verified
  returned
  incomplete
  flagged
}

/// نوعُ التغيير المُصرَّح به على التزامٍ قائم — يُسجَّل كلُّه
enum ChangeKind {
  deadline_change
  reassign
  scope_change
  defer
  waive
  cancel
  supersede
  lock_exception
  dependency_resolution
  reopen_period
  emergency_open
  priority_change
  weight_change
}

/// حالةُ اجتماع المراجعة
enum MeetingStatus {
  scheduled
  held
  cancelled
  rescheduled
}

/// هدفٌ استراتيجيٌّ للمنظمة — ولا يصير التزاماً إلا باعتماد الإدارة
model StrategicGoal {
  id          String     @id @default(cuid())
  title       String
  description String
  /// لماذا هذا الهدف، وما الأثر المتوقَّع — يُكتَبان ولا يُفترَضان
  rationale   String
  impact      String?

  /// المسؤول التنفيذي عنه، ومالكُه الذي يقوده يومياً
  accountableUserId String?
  accountable       User?   @relation("GoalAccountable", fields: [accountableUserId], references: [id], onDelete: SetNull)
  ownerUserId       String?
  owner             User?   @relation("GoalOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  startDate DateTime
  dueDate   DateTime
  /// كيف يُعرَف أنه تحقّق — معيارٌ يُقاس لا نيّةٌ تُقال
  successCriteria String
  baselineValue   String?
  targetValue     String?

  priority WorkPriority @default(normal)
  status   GoalStatus   @default(draft)

  proposedById   String?
  proposedByName String?
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?
  decisionNote   String?

  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  milestones Milestone[]
  objectives DepartmentObjective[]
  tasks      PlanTask[]
  changes    WorkChange[]

  @@index([status, dueDate])
}

/// محطةٌ شهرية: نتيجةٌ تُسلَّم في شهرٍ بعينه — لا قسمةٌ حسابيةٌ للهدف
model Milestone {
  id      String        @id @default(cuid())
  goalId  String
  goal    StrategicGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title          String
  expectedResult String
  acceptanceCriteria String

  ownerUserId String?
  owner       User?   @relation("MilestoneOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  startDate DateTime
  dueDate   DateTime
  order     Int             @default(0)
  status    ObjectiveStatus @default(approved)
  /// ما يُفعَل إن تعثّرت — يُكتَب حين تُعلَن معرَّضةً للخطر
  correctivePlan String?

  objectives DepartmentObjective[]
  tasks      PlanTask[]

  @@index([goalId, dueDate])
}

/// هدفُ قسمٍ — يقترحه قائدُه، ويرتبط بهدفٍ تنظيميٍّ حيث ينطبق
model DepartmentObjective {
  id           String         @id @default(cuid())
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         StrategicGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId  String?
  milestone    Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  title       String
  description String?
  acceptanceCriteria String?
  dueDate     DateTime?
  priority    WorkPriority    @default(normal)
  status      ObjectiveStatus @default(proposed)

  /// قائدُ القسم المسؤول — ومن اقترحه، ومن قرّر فيه
  leadUserId     String?
  lead           User?     @relation("ObjectiveLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  proposedByName String
  approvedAt     DateTime?
  approvedByName String?
  decisionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks PlanTask[]

  @@index([departmentId, status])
}

/// فترةُ تنفيذٍ أسبوعية — تنظيميةٌ واحدة، تُفتَح بإذنٍ وتُغلَق بترحيل
model ExecutionPeriod {
  id        String      @id @default(cuid())
  /// بداية الأسبوع — سبتٌ بتوقيت الرياض، وهي مفتاحُ التفرّد
  weekStart DateTime    @unique
  weekEnd   DateTime
  state     PeriodState @default(draft)

  submittedAt DateTime?
  approvedAt  DateTime?
  /// الفتح: صريحٌ ومُصرَّحٌ به ومُسجَّل — ولا يقع بمرور الوقت
  openedAt     DateTime?
  openedById   String?
  openedByName String?
  /// فتحٌ استثنائيٌّ قبل اكتمال المراجعة — بسببٍ مكتوب وعددِ ما بقي
  emergencyOpen     Boolean @default(false)
  emergencyReason   String?
  unresolvedAtOpen  Int     @default(0)

  closedAt     DateTime?
  closedById   String?
  closedByName String?

  reopenCount  Int       @default(0)
  reopenedAt   DateTime?
  reopenReason String?

  plans      WeekPlan[]
  meeting    ReviewMeeting?
  tasks      PlanTask[]        @relation("TaskCurrentPeriod")
  carriedIn  TaskCarryover[]   @relation("CarryTo")
  carriedOut TaskCarryover[]   @relation("CarryFrom")
  reviews    TaskReview[]

  @@index([state])
}

/// خطةُ قسمٍ داخل فترة — بها تُرفَع التزاماتُ القسم وتُعتمَد
model WeekPlan {
  id       String          @id @default(cuid())
  periodId String
  period   ExecutionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  state WeekPlanState @default(draft)

  submittedAt    DateTime?
  submittedByName String?
  approvedAt     DateTime?
  approvedByName String?
  decisionNote   String?

  /// طاقةُ القسم في الأسبوع بوحدات الوزن — تُضبَط ولا تُخمَّن في الكود
  capacityPoints Int?
  /// إقرارُ التحميل الزائد: لا تُعتمَد خطةٌ متجاوزةٌ إلا بقرارٍ مكتوب
  overloadAcknowledged Boolean @default(false)
  overloadNote         String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks PlanTask[]

  @@unique([periodId, departmentId])
  @@index([departmentId, state])
}

/// مهمّةٌ في خطةِ أسبوع — **صفٌّ واحدٌ يَعبر الأسابيع لا صفٌّ لكل أسبوع**
model PlanTask {
  id String @id @default(cuid())

  /// خطةُ الأسبوع التي هي فيها الآن، وفترتُها — تتبدّلان بالترحيل
  planId   String?
  plan     WeekPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  periodId String?
  period   ExecutionPeriod? @relation("TaskCurrentPeriod", fields: [periodId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  goalId      String?
  goal        StrategicGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  objectiveId String?
  objective   DepartmentObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  title       String
  description String?
  /// متى تُعَدّ منجَزة — وبلا هذا لا تُعتمَد التزاماً
  acceptanceCriteria String
  /// ما يُسلَّم فعلاً: ملفٌّ أو منشورٌ أو تقرير
  deliverable String?

  /// صاحبُها: حسابٌ إداريٌّ أو عضو — واحدٌ لا كلاهما
  ownerUserId   String?
  ownerUser     User?   @relation("TaskOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerMemberId String?
  ownerMember   Member? @relation("TaskOwnerMember", fields: [ownerMemberId], references: [id], onDelete: SetNull)

  priority WorkPriority @default(normal)
  /// وزنُها في حساب الإنجاز — متساويةٌ ما لم يُفرَّق بينها بقرار
  weight   Int          @default(1)

  /// **الموعدُ الأصلي لا يتبدّل أبداً** — وبه يُقاس التأخّر مهما مُدِّد
  originalDueAt DateTime
  /// الموعدُ المعتمَد الآن — يتبدّل بقرارٍ مسجَّل وحده
  dueAt         DateTime

  execState TaskExecState @default(not_started)

  /// ما أعلنه صاحبُها — **ولا يرفع الإنجاز المعتمَد**
  reportedDoneAt  DateTime?
  reportedByName  String?
  /// تحقُّقُ التنفيذي — وهو وحده ما يُحسَب
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedByName  String?

  blockedReason String?

  /// الترحيل: كم مرّةً رُحِّلت، وكم مرّةً على التوالي، ومن أين جاءت
  carryoverCount        Int     @default(0)
  consecutiveCarryover  Int     @default(0)
  carriedFromPeriodId   String?
  /// سببُ عدم الاكتمال وخطةُ التصحيح — **مطلوبان لترحيلها**
  carryReason           String?
  correctivePlan        String?

  waivedAt      DateTime?
  waivedReason  String?
  supersededById String?

  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions  TaskSubmission[]
  reviews      TaskReview[]
  changes      WorkChange[]
  carryovers   TaskCarryover[]
  dependsOn    TaskDependency[] @relation("Dependent")
  requiredFor  TaskDependency[] @relation("Dependency")

  @@index([periodId, execState])
  @@index([departmentId, execState])
  @@index([ownerUserId, execState])
  @@index([ownerMemberId, execState])
  @@index([dueAt])
}

/// تبعيّةٌ بين مهمّتين — تُحَلّ بقرارٍ أو بإنجاز ما تعتمد عليه
model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  task            PlanTask @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOn       PlanTask @relation("Dependency", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  note            String?
  resolvedAt      DateTime?
  resolvedByName  String?
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
}

/// سجلُّ ترحيلٍ واحد: من فترةٍ إلى فترة، بسببه وخطةِ تصحيحه.
///
/// والتفرّدُ على (المهمّة، الفترةِ المُرحَّلِ إليها) هو ما يجعل الكنس
/// **لا يُكرِّر**: تشغيلُه مرّتين في الليلة نفسها لا يَزيد عدّاداً ولا
/// يكتب صفّاً ثانياً.
model TaskCarryover {
  id           String          @id @default(cuid())
  taskId       String
  task         PlanTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromPeriodId String
  fromPeriod   ExecutionPeriod @relation("CarryFrom", fields: [fromPeriodId], references: [id], onDelete: Cascade)
  toPeriodId   String
  toPeriod     ExecutionPeriod @relation("CarryTo", fields: [toPeriodId], references: [id], onDelete: Cascade)

  /// الحالةُ التي كانت عليها لحظةَ الترحيل — فلا يُقرأ لاحقاً غيرُها
  stateAtCarry TaskExecState
  reason         String?
  correctivePlan String?
  decidedByName  String?
  createdAt      DateTime @default(now())

  @@unique([taskId, toPeriodId])
  @@index([toPeriodId])
}

/// تسليمُ عملٍ بدليله — يُراكَم ولا يُستبدَل.
///
/// والتسليمُ المردودُ يبقى: لو كُتب فوقه لَما عُرف ما رُدَّ ولا لماذا.
model TaskSubmission {
  id     String   @id @default(cuid())
  taskId String
  task   PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  note String
  /// الدليل: رابطٌ خارجيٌّ أو ملفٌّ مرفوع — بحدِّ المنصة نفسِه
  evidenceUrl      String?
  evidenceFileName String?
  evidenceMime     String?
  evidenceSize     Int?
  evidenceData     Bytes?

  submittedById   String?
  submittedByName String
  submittedAt     DateTime @default(now())

  reviews TaskReview[]

  @@index([taskId, submittedAt])
}

/// قرارُ مراجعةٍ على مهمّة — سجلٌّ لا يُعدَّل ولا يُحذف
model TaskReview {
  id     String   @id @default(cuid())
  taskId String
  task   PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   TaskSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  periodId String?
  period   ExecutionPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  decision     ReviewDecisionKind
  note         String?
  reviewerId   String?
  reviewerName String
  decidedAt    DateTime           @default(now())

  @@index([taskId, decidedAt])
}

/// تغييرٌ مُصرَّحٌ به على التزام: ما كان، وما صار، ومن قرّر، ولماذا.
///
/// وهو سجلُّ التدقيق كلِّه: تمديدُ موعدٍ، ونقلُ مسؤولية، وإسقاطُ
/// التزام، وفتحٌ استثنائيٌّ — كلُّها صفوفٌ هنا لا حقولٌ تُكتَب فوقها.
model WorkChange {
  id   String     @id @default(cuid())
  kind ChangeKind

  taskId String?
  task   PlanTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goalId String?
  goal   StrategicGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  periodId String?

  reason       String
  previousJson Json?
  nextJson     Json?
  effectiveAt  DateTime?

  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([kind, createdAt])
}

/// إعداداتُ اجتماع المراجعة الأسبوعي — ولا ساعةَ مكتوبةٌ في الكود
model MeetingConfig {
  id String @id @default("main")
  /// يومُ الأسبوع: ٦ = السبت (تقويم جافاسكربت)
  weekday         Int     @default(6)
  hour            Int     @default(21)
  minute          Int     @default(0)
  durationMinutes Int     @default(60)
  timezone        String  @default("Asia/Riyadh")
  organizerId     String?
  organizerName   String?
  locationOrUrl   String?
  agendaTemplate  String?
  updatedByName   String?
  updatedAt       DateTime @updatedAt
}

/// اجتماعُ مراجعةٍ لفترةٍ بعينها — واحدٌ لا يتكرّر
model ReviewMeeting {
  id       String          @id @default(cuid())
  periodId String          @unique
  period   ExecutionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  timezone        String        @default("Asia/Riyadh")
  organizerName   String?
  locationOrUrl   String?
  status          MeetingStatus @default(scheduled)

  heldAt        DateTime?
  rescheduledAt DateTime?
  cancelledAt   DateTime?
  notes         String?

  /// مراحلُ الأجندة المُنجَزة — تُعلَّم صراحةً ولا تُستنتَج
  stagesDoneJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions MeetingDecision[]

  @@index([scheduledAt])
}

/// قرارُ اجتماعٍ ومتابعتُه — ولا يُغيّر التزاماً معتمَداً بنفسه
model MeetingDecision {
  id        String        @id @default(cuid())
  meetingId String
  meeting   ReviewMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  text          String
  ownerUserId   String?
  dueAt         DateTime?
  createdByName String
  createdAt     DateTime  @default(now())
  doneAt        DateTime?

  @@index([meetingId, createdAt])
}

/// آخرُ مرّةٍ جرى فيها كنسٌ من الكنوس — صفٌّ لكل كنس.
///
/// **العطبُ الذي أنشأه، مقيساً:** صفحاتُ الإدارة كانت تَكنس عند كل عرض —
/// `/admin` و`/admin/operations` ولوحةُ القسم ثلاثةَ كنوسٍ لكلٍّ، وغيرُها
/// كنساً أو كنسين. والكنوسُ تَقرأ أولاً ولا تكتب إلا إن وُجد مستحَقّ،
/// فكان الثمنُ المعتاد خمسَ رحلاتٍ زائدةٍ إلى القاعدة في كل فتحةِ صفحة —
/// إحداها تَقرأ التذاكرَ المتأخّرة بكلِّ علاقاتها.
///
/// **والأسوأ ليس البطء:** متى وُجد مستحَقٌّ صار عرضُ الصفحة يكتب في
/// القاعدة **ويُرسل بريداً** — عملٌ غيرُ محدودٍ في مسار عَرْض، يُطيل
/// الانتظارَ بقدر ما وُجد من متأخّرات، ويُكرَّر مع كل فتحة.
///
/// فصار الكنسُ من الصفحات **مُقنَّناً**: من يَفوز بالصفّ يَكنس، وسائرُهم
/// يَمضون بلا كنس. والفوزُ يُحسَم في الشرط نفسِه (`where` فيه المهلة) لا
/// بقراءةٍ ثم قرار — فلامبدا تانِ تَفتحان الصفحةَ معاً لا تَكنسان معاً.
/// والكنسُ المجدول (`/api/cron/sweep`) لا يمرّ بهذا: موعدُه موعدُه.
model SweepRun {
  key       String   @id
  lastRunAt DateTime
}
