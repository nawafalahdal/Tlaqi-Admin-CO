generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  executive
  operations_officer
  department_admin
}

enum InviteTargetRole {
  member
  department_admin
  operations_officer
  executive
}

enum InviteStatus {
  open
  used
  expired
}

enum TestStatus {
  not_started
  passed
  failed
}

enum ApprovalStatus {
  pending_review
  approved
  rejected
}

enum RequestType {
  welcome_banner
  custom_design
  dept_contact
  meeting
  content_writing
  design_work
  publishing
  tech_support
  hr_support
  equipment
  budget_approval
  escalate_to_executive
  escalate_to_founder
  other
}

enum RequestStatus {
  new
  in_progress
  done
  overdue
}

enum TestTrackScope {
  department_member
  department_admin
  operations_officer
  executive
}

/// حالة طلب الاعتماد الإداري على تذكرة.
///
/// وهي مستقلّة عن `TicketStatus`: التذكرة قد تكون مفتوحة وطلبُها معتمداً،
/// أو مفتوحة وطلبُها مردوداً للتعديل. فخلطُهما في عمودٍ واحد يُفقِد
/// أحدهما — وقد كان ذلك أول ما فكّرت فيه.
///
/// والحالة تعكس **آخر إجراءٍ فعلي**: فتحُ الطلب واستعراضُه لا يُغيّرها.
enum ApprovalState {
  /// مسودة: صاحبها يُعدّها ولم تُرسَل بعد
  draft
  /// بانتظار الاعتماد: وصلت المعتمِد ولم يقرأها بعد
  awaiting
  /// قيد المراجعة: المعتمِد أعلن أنه يدرسها — إجراءٌ صريح لا أثرُ فتح
  reviewing
  /// مردودة للتعديل: بملاحظاتٍ مكتوبة، وصاحبها يُعدّل ويُعيد
  returned
  /// معتمدة — وإن كان المسار متسلسلاً فهذا اعتماد المرحلة الحالية
  approved
  /// مرفوضة بسببٍ مكتوب
  rejected
  /// قيد التنفيذ: انتقل صاحبها إلى العمل بعد الاعتماد
  executing
  /// مكتملة
  completed
}

/// نوع طلب الاعتماد — يُعرَض ويُصفّى به، ولا يُغيّر المسار بنفسه
enum ApprovalKind {
  marketing_plan
  financial_plan
  initiative
  resources
  operational
  other
}

/// قرارُ معتمِدٍ على طلب — سجلٌّ لا يُعدَّل ولا يُحذف.
///
/// القرارات تُحفظ صفّاً لكل قرار لا عموداً يُستبدَل: الطلب الذي رُدّ
/// للتعديل ثم أُعيد ثم اعتُمد له ثلاثة قرارات، ولو كُتب كلٌّ فوق سابقه
/// لم يبقَ من التاريخ إلا آخرُه. وهذا هو سجلّ التدقيق.
model ApprovalDecision {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// من قرّر — ولا يُحذف قرارُه بحذف حسابه، بل يُفَكّ ويبقى اسمُه
  deciderId  String?
  decider    User?         @relation("ApprovalDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  /// الاسم محفوظٌ نصّاً أيضاً: القرار ينسب إلى صاحبه حتى لو زال حسابه
  deciderName String
  /// الحالة التي صار إليها الطلب بهذا القرار
  decision   ApprovalState
  /// الملاحظة — إلزاميةٌ في الردّ للتعديل والرفض
  note       String?
  /// رقم المرحلة في المسار المتسلسل: ١ للمعتمِد الأول، ٢ للذي يليه
  step       Int           @default(1)
  decidedAt  DateTime      @default(now())

  @@index([ticketId, decidedAt])
}

enum TicketStatus {
  open
  in_progress
  resolved
}

/// مرحلة تصعيد التذكرة: القسم المستهدف أولاً (يومان) ← قائد قسم العضو نفسه
/// (يومان إضافيان) ← الإدارة التنفيذية (نهائي)
enum TicketStage {
  department
  lead_escalation
  ceo_escalation
  founder_escalation
}

/// حالةُ اللجنة في مسارها من الاقتراح إلى الفتح.
///
/// و`null` ليست حالةً ناقصة: هي علامةُ القسم الأصيل. الأقسام لا تُعتمَد
/// — تُنشَأ بقرار من يملك الهيكل. واللجنة وحدها تمرّ باعتماد.
enum CommitteeStatus {
  /// اقترحها قائد القسم وتنتظر قرار المدير التنفيذي
  pending_review
  /// اعتُمدت فانفتحت: لها بنك أسئلة، وتُدعى لها قيادة، وتظهر في الهيكل
  approved
  /// رُدَّت بسببٍ مكتوب — لا تُفتح ولا تظهر في الهيكل
  rejected
}

/// قسم داخلي — كل قسم له لون هوية خاص (hex) يُستخدم في تخصيص الواجهات.
///
/// **واللجنة قسمٌ له أبٌ لا جدولٌ ثانٍ.** وهذا أهمُّ قرارٍ في هذه
/// الميزة: لو كانت اللجنة جدولاً مستقلاً لاحتاجت دعواتَها وبنكَ أسئلتها
/// وتذاكرَها وتوقيعاتَها وإعلاناتَها وصفَّها في الهيكل — نسخةً ثانية من
/// سبعة مسارات، يُصلَح أحدها ويُنسى توأمُه. وبـ`parentId` وحده دارت
/// الدائرةُ كما طُلبت: قائدُ اللجنة `department_admin` قسمُه اللجنة،
/// فلوحتُه ودعواتُه واختبارُه وتذاكرُه تعمل من يومها بلا سطرٍ جديد.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  colorHex  String
  createdAt DateTime @default(now())

  /// قسم استثنائي لا يُدار كبقية الأقسام: أعضاؤه (ممثل قانوني، مستشار،
  /// جهة خارجية) يتبعون الإدارة العليا وحدها، ولا تُوجَّه إليهم تذاكر
  /// الأقسام ولا تصلهم إعلاناتها. وجوده بعلم الإدارة العليا لا بإدارتها.
  leadershipOnly Boolean @default(false)

  /// أبُ اللجنة — القسم الذي هي داخله. و`null` قسمٌ أصيل.
  ///
  /// والحذف مقيَّد (`Restrict`) عمداً: قسمٌ يحمل لجنةً لا يُحذف حتى
  /// تُفرَّغ لجنتُه — فلا تبقى لجنةٌ معلّقةٌ بأبٍ زائل.
  parentId   String?
  parent     Department?  @relation("DepartmentCommittees", fields: [parentId], references: [id], onDelete: Restrict)
  committees Department[] @relation("DepartmentCommittees")

  /// `null` للقسم الأصيل، وللجنة حالتُها في مسار الاعتماد
  committeeStatus CommitteeStatus?

  /// المسمّى الذي يحمله قائد اللجنة — «مسؤول لجنة التطوير» وما شابه.
  /// يختاره قائدُ القسم حين يقترحها، فلا يُسمّي القائدُ نفسَه بما يشاء.
  leadTitle       String?

  /// من اقترحها ومتى. والمعرّف نصٌّ بلا علاقةٍ أجنبية عن قصد: علاقةٌ
  /// لازمة إلى `User` تمنع حذف الحساب بقيدٍ غامض (P2003) — وقد وقع ذلك
  /// في هذه المنصة من قبل بـ`Invite.invitedById`. والاسم محفوظٌ نصّاً
  /// فيبقى منسوباً لصاحبه ولو زال حسابه.
  requestedById   String?
  requestedByName String?
  requestedAt     DateTime?

  /// القرار: متى، وبيد من، وبأي ملاحظة — والملاحظة إلزاميةٌ في الردّ
  decidedAt       DateTime?
  decidedByName   String?
  decisionNote    String?

  admins        User[]
  invites       Invite[]
  members       Member[]
  requests      Request[]      @relation("TargetDepartmentRequests")
  testTracks    TestTrack[]
  signatures    LeaderSignature[]
  tickets       Ticket[]       @relation("TicketTargetDepartment")
  announcements Announcement[]
}

/// حساب إداري (قائد قسم / تنفيذي / الإدارة العليا) — يُنشأ إما مباشرة (بذرة النظام)
/// أو تلقائياً عند اعتماد مرشح قيادي بعد اجتيازه اختبار المستوى المناسب
model User {
  id                 String      @id @default(cuid())
  fullName           String
  email              String      @unique
  passwordHash       String
  mustChangePassword Boolean     @default(false)
  totpSecret         String?
  totpEnabled        Boolean     @default(false)
  role               UserRole
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  createdAt          DateTime    @default(now())

  // التنحية لا تحذف الحساب: تُعطّله وتُفرِغ المنصب لمن بعده، ويبقى سجله
  isActive      Boolean   @default(true)
  removedAt     DateTime?
  removalReason String?

  // رقم صفه الثابت في تبويب "الحسابات الإدارية" — يُحفظ أول مرة فقط ليُحدَّث
  // الصف نفسه بعدها بدل تكديس صف جديد عند كل تغيّر
  sheetRow          Int?
  passwordChangedAt DateTime?

  // بيانات صاحب الحساب الإداري — نفس ما يسجّله العضو قبل اختباره.
  // الفاوندر والتنفيذي إداريان قبل أن يكونا لقبين، فلهما سجلّ كغيرهما.
  phone              String?
  jobTitle           String?
  /// الصورة الشخصية — انظر `Member.avatarData`
  avatarData         String?
  specialization     String?
  section            String?
  profileCompletedAt DateTime?

  // البريد الترحيبي: متى وصله، وكم مرة أُعيد إرساله بطلبه
  welcomeEmailSentAt DateTime?
  welcomeEmailCount  Int       @default(0)
  // آخر مرة نُبّه فيها لتفعيل التحقق الثنائي — حتى لا يتكرّر كل يوم
  totpNudgedAt       DateTime?

  invitesIssued   Invite[] @relation("InvitedBy")
  ticketsRaised   Ticket[] @relation("TicketRaisedBy")
  ticketsAssigned Ticket[] @relation("TicketTargetUser")
  ticketsResolved Ticket[] @relation("TicketResolvedBy")
  memberDateEdits MemberDateEdit[] @relation("MemberDateEditor")
  signatures      LeaderSignature[] @relation("SignatureOwner")
  signaturesApproved LeaderSignature[] @relation("SignatureApprover")
  terminationsDecided TerminationRequest[] @relation("TerminationDecider")
  approvalsPending    Ticket[]             @relation("TicketApprover")
  approvalsGranted    Ticket[]             @relation("TicketApprovedBy")
  approvalDecisions   ApprovalDecision[]   @relation("ApprovalDecider")
}

/// دعوة مقفلة بالاسم والإيميل — لا تسجيل عام. targetRole يحدد المسار:
/// عضو قسم (يدعوه أدمن قسمه) / قائد قسم (يدعوه المؤسس أو التنفيذي) / تنفيذي (المؤسس فقط)
model Invite {
  id           String           @id @default(cuid())
  token        String           @unique @default(cuid())
  fullName     String
  email        String
  targetRole   InviteTargetRole @default(member)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  testTrackId  String
  testTrack    TestTrack        @relation(fields: [testTrackId], references: [id])
  invitedById  String
  invitedBy    User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status       InviteStatus     @default(open)
  /// وصول بريد الدعوة: متى وصل، وكم مرّة حُوِلت.
  ///
  /// لولا هذا لا يُعرف الفرق بين دعوةٍ وصلت ولم يفتحها صاحبها ودعوةٍ لم
  /// تصل أصلاً — والأولى تُنتظَر والثانية تُعاد. والإعادة لا تُنشئ دعوةً
  /// ثانية: `resetMemberCredentials` يُصدر رمزاً جديداً للدعوة نفسها.
  emailSentAt  DateTime?
  emailAttempts Int             @default(0)
  createdAt    DateTime         @default(now())

  member Member?
}

/// مرشح مرّ بدورة دعوة/اختبار — لأي مستوى (عضو/قائد قسم/تنفيذي). بعد الاعتماد
/// يصبح له حساب دخول دائم (مباشرة كـ Member للأعضاء، أو يُنشأ له User للقيادة)
model Member {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  phone           String?
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  jobTitle        String?
  /// الصورة الشخصية — صورةٌ واحدة معتمدة لكل شخص، مُوحَّدة عند الاستلام.
  ///
  /// تُخزَّن data URL كما يُخزَّن توقيع القائد: لا مخزن ملفّات في المنصة،
  /// والصورة مُصغَّرةٌ مُوحَّدةُ الأبعاد عند الرفع فحجمها معلوم.
  avatarData      String?
  joinDate        DateTime       @default(now())
  /// تاريخ الانضمام الفعلي لتَـــلاقِ — لا تاريخ إنشاء حسابه.
  ///
  /// بعضهم انضمّ قبل أن توجد المنصة، فتاريخُ حسابه ليس تاريخَ انضمامه.
  /// وهي خمسة تواريخ لا تُخلَط: إنشاء الحساب (`createdAt`)، والانضمام
  /// التنظيمي (هذا)، وبداية التكليف الإداري (`decidedAt`)، ونهايته
  /// (`endDate`)، وإصدار الشهادة (`certificateIssuedAt`).
  ///
  /// ويبقى `null` لمن لا يُعرف تاريخه: لا يُخترَع تاريخٌ لمن جُهل أمره.
  orgJoinDate     DateTime?
  testScore       Int?
  testStatus      TestStatus     @default(not_started)
  approvalStatus  ApprovalStatus @default(pending_review)
  assignedAdminId String?
  inviteId        String         @unique
  invite          Invite         @relation(fields: [inviteId], references: [id])
  createdAt       DateTime       @default(now())
  decidedAt       DateTime?

  // بيانات الدخول — تُنشأ لحظة إنشاء الحساب (قبل الاختبار)، فالمرشّح يدخل
  // بالرمز المؤقت أولاً ثم يغيّره ثم يبدأ اختباره داخل المنصة
  passwordHash        String?
  mustChangePassword  Boolean   @default(false)
  credentialsIssuedAt DateTime?
  firstLoginAt        DateTime?
  isActive            Boolean   @default(true)
  warningsCount       Int       @default(0)
  terminatedAt        DateTime?
  exitReason          String?
  certificateIssuedAt DateTime?
  // إصدار الشهادة وتسليمها حدثان لا حدث: الإصدار مرّة واحدة لكلّ انتهاء
  // (فلا تُصدَر شهادتان لمسيرةٍ واحدة)، والتسليم يُعاد إن فشل البريد.
  // ولو كان الحدث واحداً لمنع فشلُ الإرسال إعادةَ المحاولة أبداً.
  certificateSentAt   DateTime?
  // شهادة الثلاثة أشهر — حدثٌ مستقلٌّ عن شهادة الإنهاء، له ختماه.
  // `appreciationDueAt` يُسجَّل يوم الاستحقاق كما حُسب، لا يوم الإرسال:
  // فمن أُرسلت له متأخّرةً (تعطّل الكنس يوماً) يبقى في السجل أنه
  // استحقّها في موعدها.
  appreciationDueAt   DateTime?
  appreciationIssuedAt DateTime?
  appreciationSentAt  DateTime?
  sheetRow            Int?

  // بيانات يسجّلها المرشّح بنفسه قبل بدء الاختبار — تُكتب في الشيت فوراً
  specialization     String?
  section            String?
  profileCompletedAt DateTime?

  // إعادة فتح الاختبار بعد عدم الاجتياز: من أعادها، ومتى، وعلى أي أساس
  testReopenCount Int       @default(0)
  testReopenedAt  DateTime?
  testReopenNote  String?

  // البريد الترحيبي: متى وصله، وكم مرة أُعيد إرساله بطلبه
  welcomeEmailSentAt DateTime?
  welcomeEmailCount  Int       @default(0)

  // حوكمة التنحي: لا ينتهي أحد فجأة ولا يبقى معلّقاً بلا تاريخ.
  // يُنحّيه قائده، فيتوقّف عمله ويُحدَّد تاريخ انتهائه، ثم لا تُغلق
  // تجربته حتى تُسلَّم شهادته ويُصمَّم وداعه — ويُسجَّل كل ذلك بتاريخه.
  stepDownAt          DateTime?
  stepDownByName      String?
  endDate             DateTime?
  farewellDesignAt    DateTime?
  // إغلاق التجربة: تُرسل رسالة الشكر الأخيرة، ولا يصله بعدها بريد أبداً
  offboardingClosedAt DateTime?
  noFurtherEmail      Boolean   @default(false)

  testAttempts    TestAttempt[]
  requests        Request[]       @relation("LinkedMemberRequests")
  warnings        MemberWarning[]
  tickets         Ticket[]
  ticketsAssigned Ticket[]        @relation("TicketTargetMember")
  dateEdits       MemberDateEdit[]
  terminationRequests TerminationRequest[]

  // الكنس اليومي يسأل: من لم تصله شهادة تقديره؟ فيُجاب رخيصاً
  @@index([appreciationSentAt])
}

model TestAttempt {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  answers     Json
  score       Int
  passed      Boolean
  attemptedAt DateTime @default(now())
}

/// بنك أسئلة قابل للتعديل حسب المستوى: اختبار أعضاء قسم معيّن (يعدّله أدمن ذلك
/// القسم)، اختبار قادة الأقسام (يعدّله التنفيذي), اختبار التنفيذيين (يعدّله المؤسس فقط)
model TestTrack {
  id           String         @id @default(cuid())
  scope        TestTrackScope
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  createdAt    DateTime       @default(now())

  questions TestQuestion[]
  invites   Invite[]

  @@unique([scope, departmentId])
}

model TestQuestion {
  id           String    @id @default(cuid())
  trackId      String
  track        TestTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json
  correctIndex Int
  order        Int       @default(0)
}

/// تنبيه يصدره أدمن القسم لعضو معتمد — ٣ تنبيهات تؤدي لاستبعاد تلقائي
model MemberWarning {
  id             String    @id @default(cuid())
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id])
  issuedByUserId String
  reason         String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
}

/// طلب داخلي بين الأقسام — مالك واحد واضح (targetDepartment) لكل طلب
model Request {
  id                 String        @id @default(cuid())
  type               RequestType
  createdById        String?
  targetDepartmentId String
  targetDepartment   Department    @relation("TargetDepartmentRequests", fields: [targetDepartmentId], references: [id])
  status             RequestStatus @default(new)
  dueDate            DateTime?
  linkedMemberId     String?
  linkedMember       Member?       @relation("LinkedMemberRequests", fields: [linkedMemberId], references: [id])
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

/// تذكرة يرفعها عضو (مثال: لم يصله البانر الترحيبي). تصعيد تلقائي صارم إذا لم
/// يُستجب خلال المهلة: القسم المستهدف (يومان) ← قائد قسم العضو (يومان) ← الإدارة التنفيذية
model Ticket {
  id                 String       @id @default(cuid())
  ticketNumber       Int          @unique @default(autoincrement())
  subject            String
  description        String
  // صاحب التذكرة: عضو أو حساب إداري — واحد منهما لا كلاهما
  memberId           String?
  member             Member?      @relation(fields: [memberId], references: [id])
  raisedByUserId     String?
  raisedByUser       User?        @relation("TicketRaisedBy", fields: [raisedByUserId], references: [id])
  // الوجهة: قسم كامل أو شخص بعينه — واحدة منهما
  targetDepartmentId String?
  targetDepartment   Department?  @relation("TicketTargetDepartment", fields: [targetDepartmentId], references: [id])
  targetUserId       String?
  targetUser         User?        @relation("TicketTargetUser", fields: [targetUserId], references: [id])
  targetMemberId     String?
  targetMember       Member?      @relation("TicketTargetMember", fields: [targetMemberId], references: [id])
  /// رابط مرفق اختياري — منشور، ملف، أو اجتماع يخصّ التذكرة
  linkUrl            String?
  status             TicketStatus @default(open)
  stage              TicketStage  @default(department)
  stageDueAt         DateTime
  /// الموعد الأول كما حُدِّد لحظة الرفع — لا يتبدّل بالتصعيد أبداً.
  ///
  /// `stageDueAt` يُجدَّد عند كل تصعيد، فيُفقَد الموعد الأصلي. وبدونه
  /// لا يُقاس التأخّر إلا استنتاجاً من المرحلة («إن صُعِّدت فقد تأخّرت»)
  /// — وهو استنتاجٌ صحيحٌ تقريباً وهشٌّ: أيُّ مسٍّ للمرحلة يُفسد عمود
  /// «متأخرة؟» في الإكسل. فصار القياس على موعدٍ ثابت لا على مرحلةٍ
  /// متحرّكة.
  firstDueAt         DateTime?
  resolutionNote     String?
  resolvedAt         DateTime?
  /// من أغلقها — الإغلاق تصرّفٌ يُنسَب لصاحبه، لا حدثٌ بلا فاعل
  resolvedByUserId   String?
  resolvedByUser     User?        @relation("TicketResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  /// طلبُ اعتمادٍ إداري: اختياريٌّ على التذكرة لا لازمٌ لها.
  ///
  /// `null` يعني تذكرةً عادية — وهي الأكثر. ولو جُعل الاعتماد لازماً لكل
  /// تذكرة لصار على كل سؤالٍ يوميٍّ بابُ موافقة.
  approvalState      ApprovalState?
  approvalKind       ApprovalKind?
  /// المعتمِد المنتظَر الآن. يتبدّل في المسار المتسلسل إلى الذي يليه.
  approverUserId     String?
  approverUser       User?        @relation("TicketApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  /// المسار المتسلسل: معرّفات المعتمِدين بالترتيب، وأوّلُهم هو
  /// `approverUserId` ابتداءً. فارغٌ يعني اعتماداً واحداً.
  approvalChain      String[]     @default([])
  /// المرحلة الحالية في المسار — تبدأ عند ١
  approvalStep       Int          @default(1)
  /// الاعتماد النهائي: يُكتب حين تكتمل كل الموافقات المطلوبة لا أوّلُها
  approvedAt         DateTime?
  approvedByUserId   String?
  approvedByUser     User?        @relation("TicketApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  /// كم مرّة رُدَّت للتعديل — يُقرأ تاريخاً مع `decisions`
  returnCount        Int          @default(0)
  decisions          ApprovalDecision[]

  /// سُحبت بطلب صاحبها — إغلاقٌ ليس إجابة.
  ///
  /// التذكرة التي رفعها صاحبها ثم بلغت آخر السلسلة ولم يكن في المرحلة
  /// الأخيرة أحدٌ غيره، كانت تقف إلى الأبد: الوحيد المصرَّح له هو
  /// صاحبها، وصاحبها لا يُجيب نفسه. فصار له أن يسحبها — وهذا يُسجَّل
  /// سحباً لا حلاً، فلا يُقال في السجل إن أحداً أجاب وقد لم يُجب.
  withdrawnAt        DateTime?
  /// إعادة الفتح: لا تقع إلا بتصرّفٍ صريح مُصرَّح به، ويُسجَّل كم مرّة
  reopenCount        Int          @default(0)
  reopenedAt         DateTime?
  sheetRow           Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // الكنس يسأل: من تأخّر وما يزال مفتوحاً؟ فيُجاب بفهرسٍ لا بمسحٍ كامل
  @@index([status, stageDueAt])
}

/// جمهور الإعلان — يحدد من يراه على لوحته
enum AnnouncementAudience {
  everyone
  leadership
  department
}

/// إعلان داخلي ينشره المؤسس أو التنفيذي أو مسؤول التشغيل — يظهر لجمهوره
/// المحدد على رأس لوحته، وهو قناة التواصل الرسمية بدل الرسائل المتفرقة
model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  audience     AnnouncementAudience @default(everyone)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  authorId     String
  authorName   String
  createdAt    DateTime             @default(now())
  pinnedUntil  DateTime?

  /// رابط اجتماع (Google Meet وغيره) — الإدارة العليا وحدها تضعه
  meetingUrl String?
  /// رابط مرفق عام: منشور يُطلب التفاعل معه، نموذج، أو مستند
  linkUrl    String?
  linkLabel  String?

  // هل نُسخ الإعلان إلى بريد الجميع، لا على المنصة وحدها
  sentByEmail     Boolean @default(false)
  emailRecipients Int     @default(0)

  // الإعلانات تُقرأ دائماً بالأحدث أولاً — الفهرس مصرَّح به هنا لأنه
  // أُنشئ يدوياً من قبل ولم يكن في المخطط، فكاد يُسقَط عند أول ترحيل
  @@index([createdAt(sort: Desc)])
}

/// يمنع هجمات التخمين وحشو بيانات الاعتماد — يتتبع محاولات الدخول الفاشلة لكل
/// بريد إلكتروني، ويقفل الحساب مؤقتاً بعد عدد محاولات محدد
model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// رمز استعادة كلمة المرور — يُخزَّن مُجزّأً (hash) لا نصاً صريحاً: من يطّلع
/// على القاعدة لا يستطيع انتحال طلب استعادة. صالح لمرة واحدة ولمدة قصيرة.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// سجل كل رسالة تُرسلها المنصة. كان هذا السجل يعيش في Google Sheet وحده،
/// فلا تستطيع المنصة عرضه ولا البحث فيه، ويضيع كله إن تعطّل الاتصال بالشيت.
/// الآن يُكتب هنا أولاً — وهو المصدر — ثم يُنسخ إلى الشيت.
model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  kind      String
  subject   String
  status    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([recipient])
}

/// رمز الدخول لمرة واحدة. يُرسَل إلى بريد صاحب الحساب بعد صحّة كلمة
/// المرور، فلا يكفي معرفةُ الكلمة وحدها للدخول: يلزم الوصول إلى البريد.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// سجلّ تعديل تواريخ العضوية — تصحيحُ تاريخٍ تصرّفٌ يُراجَع لا يُفترَض.
///
/// المؤسس يصحّح تاريخ انضمامٍ تنظيميٍّ لمن سبق المنصة. ولأن التواريخ
/// تحكم الاستحقاقات (شهادة الثلاثة أشهر مثلاً)، يُحفظ ما كان وما صار
/// ومن غيّره ومتى — فلا يُقال «لماذا استحقّ هذا مبكراً؟» بلا جواب.
model MemberDateEdit {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// اسم الحقل كما في النموذج: `orgJoinDate` وغيره
  field     String
  previous  DateTime?
  next      DateTime?
  /// من عدّله — يبقى اسمه ولو حُذف حسابه لاحقاً
  editedById   String?
  editedByUser User?  @relation("MemberDateEditor", fields: [editedById], references: [id], onDelete: SetNull)
  editedByName String
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

/// حالة توقيع القائد في مساره من الطلب إلى الاعتماد
enum SignatureStatus {
  /// طُلب منه ولم يرفع بعد
  requested
  /// رفعه وينتظر اعتماد الإدارة
  submitted
  /// اعتُمد — وهو وحده ما يُرسَم على الشهادات
  approved
  /// رُفض بسبب مكتوب
  rejected
  /// بطل لأن صاحبه لم يبقَ في منصبه
  superseded
}

/// توقيع قائد — يُرسَم على الشهادات التي يُوقّعها.
///
/// **ولا يُعاد استعمال توقيع قائدٍ سابق لخَلَفِه أبداً.** التوقيع مرتبط
/// بصاحبه ودوره وقسمه، لا بالمنصب وحده. فمن خرج بطل توقيعه
/// (`superseded`) ولم يُورَّث، ومن جاء طُلب منه توقيعُه هو. وتوريثُه
/// انتحالٌ: شهادةٌ تحمل توقيع من لم يكن في المنصة يوم صدورها.
///
/// والشهادات الصادرة تبقى صحيحة بتوقيعاتها: `certificateIssuedAt` يُثبت
/// وقتها، وبطلانُ التوقيع لاحقاً لا يُبطل ما مضى.
model LeaderSignature {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("SignatureOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// الدور والقسم حين طُلب التوقيع — فلا يُستعمل توقيعُ قائدٍ لقسمٍ آخر
  role         String
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  status       SignatureStatus @default(requested)
  /// صورة التوقيع كـdata URL — صغيرةٌ بطبعها، ولا مخزن ملفّات في المنصة
  imageData    String?
  requestedAt  DateTime        @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?           @relation("SignatureApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?
  rejectionNote String?
  supersededAt DateTime?
  /// متى ذُكِّر صاحبه آخر مرّة — فلا يُذكَّر كل يوم
  remindedAt   DateTime?

  createdAt    DateTime        @default(now())

  /// لكل شخصٍ في دورٍ وقسمٍ توقيعٌ واحدٌ حيّ
  @@index([userId, status])
  @@index([role, departmentId, status])
}

/// حالة طلب إنهاء فترة الإدارة
enum TerminationStatus {
  /// رفعه صاحبه وينتظر قرار مسؤوله
  submitted
  /// طلب المسؤول لقاءً قبل أن يقرّر — **وليس قراراً**
  meeting_requested
  /// وُوفق عليه: ينتهي بتاريخٍ محدّد
  approved
  /// رُفض بتفسيرٍ مكتوب
  rejected
  /// وُوفق عليه وحلّ تاريخُه ونُفِّذ الخروج
  effective
  /// سحبه صاحبه قبل القرار
  withdrawn
}

/// «طلب إنهاء فترة الإدارة في تَـــلاقِ» — يرفعه صاحبه لا تُقرّره عنه.
///
/// والرفع لا يُعطّل أحداً: من طلب الإنهاء يبقى على عمله حتى يُقرّر
/// مسؤولُه وتحلّ مهلته. ولو عُطِّل بالرفع لصار الطلب عقوبةً يخشاها من
/// يحقّ له طلبُه، ولأمكن أن يُخرِج نفسَه بضغطةٍ بلا مراجعة.
///
/// ولقاءُ المسؤول ليس قراراً: قد يُقنعه بالبقاء أو يتفهّم فيوافق —
/// وفي الحالتين القرار يأتي بعده لا معه.
model TerminationRequest {
  id          String            @id @default(cuid())
  memberId    String
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// التكليف المعنيّ كما كان وقت الطلب — فلا يُقرأ لاحقاً تكليفاً آخر
  assignmentLabel String
  /// سبب الطلب بكلمات صاحبه
  reason      String
  status      TerminationStatus @default(submitted)

  submittedAt DateTime          @default(now())
  /// التاريخ المقترح للانتهاء — يقترحه صاحبه ويُثبته القرار
  requestedEndDate DateTime?

  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?             @relation("TerminationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedByName String?
  /// تفسير الرفض، أو ملاحظة الموافقة، أو ما قيل في طلب اللقاء
  decisionNote String?

  /// متى طُلب اللقاء وما موعده — ولا يُعدّ قراراً
  meetingRequestedAt DateTime?
  meetingNote  String?

  /// متى نُفِّذ الخروج فعلاً — بعد الموافقة وحلول التاريخ
  effectiveAt DateTime?

  createdAt   DateTime          @default(now())

  @@index([memberId, status])
  @@index([status, submittedAt])
}

/// عدّادُ نتائج التذاكر — يبقى بعد أن تُؤرشَف التذاكر نفسها.
///
/// التذاكر المغلقة تُحال إلى الإكسل أسبوعياً لتبقى المنصة خفيفة، فلو
/// حُسبت التقارير من صفوفها لصار التقرير أسبوعاً واحداً ثم يُفرَّغ. ولو
/// أُبقيت الصفوف من أجل التقرير لعاد الحمل الذي أُريد تخفيفه.
///
/// فالنتيجة تُعَدّ لحظةَ الإغلاق في صفٍّ واحدٍ لكل نطاق — قسمٍ أو شخص —
/// ويبقى العدّاد وإن زالت التذاكر. وهو صغيرٌ ثابت: صفٌّ لكل نطاق لا صفٌّ
/// لكل تذكرة.
model TicketTally {
  id    String @id @default(cuid())
  /// النطاق: `dept:<id>` أو `user:<id>`
  scope String @unique
  /// أُغلقت قبل موعدها الأصلي
  onTime    Int @default(0)
  /// أُغلقت بعده
  late      Int @default(0)
  /// سحبها صاحبها — لا تُحسب التزاماً ولا تأخّراً
  withdrawn Int @default(0)
  updatedAt DateTime @updatedAt
}
